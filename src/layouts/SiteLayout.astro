---
import { siteContent } from '../content/site';
import ThemePicker from '../components/ui/ThemePicker.astro';
import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
  immersive?: boolean;
}
const {
  title,
  description = siteContent.description,
  immersive = false,
} = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html
  lang="en"
  data-theme="original"
  data-presentation={immersive ? 'immersive' : 'portfolio'}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1020" />
    <title>{title} · {siteContent.brand}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {immersive && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300..700&display=swap"
          rel="stylesheet"
        />
      </>
    )}
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const stored = localStorage.getItem('taqueria-theme');
        const theme = stored === 'vintage' ? 'synthwave' : stored;
        if (['original', 'noir', 'synthwave'].includes(theme))
          document.documentElement.dataset.theme = theme;
      } catch {
        /* The default theme remains available without storage. */
      }
    </script>
  </head>
  <body data-layout={immersive ? 'immersive' : 'portfolio'}>
    <slot name="loader" />
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header
      class:list={[
        'site-header',
        'shell',
        { 'site-header--immersive': immersive },
      ]}
    >
      <a
        class:list={['brand', { 'brand--identity': immersive }]}
        href="/"
        aria-label="Taquería Aldo home"
      >
        {immersive ? (
          <>
            <strong>
              {siteContent.name}
              <span class="brand-dot">.</span>
            </strong>
            <span class="identity-line">{siteContent.headerLine}</span>
          </>
        ) : (
          <>
            ALDO<span class="brand-dot">.</span>
          </>
        )}
      </a>
      <nav aria-label="Main navigation">
        {[
          ['/work', 'Work'],
          ...(siteContent.cvUrl ? [[siteContent.cvUrl, 'CV']] : []),
          ['/about', 'About'],
          ['/contact', 'Contact'],
        ].map(([path, label]) => (
          <a
            href={path}
            aria-current={
              currentPath === path || currentPath.startsWith(`${path}/`)
                ? 'page'
                : undefined
            }
          >
            {label}
          </a>
        ))}
      </nav>
      {!immersive && (
        <a class="back-link" href="/">
          <span class="back-long">Back to </span>stand{' '}
          <span aria-hidden="true">↗</span>
        </a>
      )}
    </header>
    <main id="main">
      <slot />
    </main>
    {!immersive && (
      <footer class="site-footer shell">
        <div>
          <a class="brand" href="/">
            ALDO<span class="brand-dot">.</span>
          </a>
          <p>A creative portfolio, served after dark.</p>
        </div>
        <ThemePicker />
        <a class="text-link" href="/work">
          View work <span aria-hidden="true">↗</span>
        </a>
      </footer>
    )}
  </body>
</html>
