---
import type { GetStaticPaths } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
  orderedProjects,
  projectPath,
  type Project,
} from '../../content/portfolio';
import ProjectVisual from '../../components/work/ProjectVisual.astro';
import '../../components/work/work.css';

export const getStaticPaths = (() =>
  orderedProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))) satisfies GetStaticPaths;
interface Props {
  project: Project;
}
const { project } = Astro.props;
const index = orderedProjects.findIndex((entry) => entry.slug === project.slug);
const previous = orderedProjects[index - 1];
const next = orderedProjects[index + 1];
---

<SiteLayout title={project.title} description={project.summary}>
  <article class="work-case-study shell">
    <a class="text-link" href={`/work#project-${project.slug}`}>
      <span aria-hidden="true">←</span> Back to Selected work
    </a>
    <header class="case-study-hero">
      <div>
        <p class="eyebrow">
          {String(project.order).padStart(2, '0')} / {project.eyebrow}
        </p>
        <h1>{project.title}</h1>
        <p class="case-study-intro">{project.caseStudy.intro}</p>
        <p class="project-highlight">{project.highlight}</p>
      </div>
      <ProjectVisual project={project} />
    </header>
    <div class="case-study-body">
      <dl class="case-study-facts">
        {project.caseStudy.role && (
          <div>
            <dt>Contribution</dt>
            <dd>{project.caseStudy.role}</dd>
          </div>
        )}
        <div>
          <dt>Focus &amp; technologies</dt>
          <dd>{project.technologies.join(' · ')}</dd>
        </div>
      </dl>
      {project.caseStudy.sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          <p>{section.body}</p>
        </section>
      ))}
      {project.images?.map((image) => (
        <figure>
          <img
            src={image.src}
            alt={image.alt}
            width={image.width}
            height={image.height}
            loading="lazy"
          />
        </figure>
      ))}
      {project.links && project.links.length > 0 && (
        <section>
          <h2>Explore the project</h2>
          <ul>
            {project.links.map((link) => (
              <li>
                <a href={link.url}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <nav class="project-sequence" aria-label="Project navigation">
        {previous && (
          <a href={projectPath(previous)} rel="prev">
            <span aria-hidden="true">←</span> {previous.title}
          </a>
        )}
        {next && (
          <a href={projectPath(next)} rel="next">
            {next.title} <span aria-hidden="true">→</span>
          </a>
        )}
      </nav>
      <a class="text-link" href="/work">
        All selected work <span aria-hidden="true">↗</span>
      </a>
    </div>
  </article>
</SiteLayout>
