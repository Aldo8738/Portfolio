---
import type { GetStaticPaths } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { projects, type Project } from '../../content/portfolio';

export const getStaticPaths = (() =>
  projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))) satisfies GetStaticPaths;
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<SiteLayout title={project.title} description={project.summary}>
  <article class="content-page shell case-study">
    <a class="text-link" href="/work">
      All work
    </a>
    <header>
      <p class="eyebrow">{project.role}</p>
      <h1>{project.title}</h1>
      <p>{project.summary}</p>
    </header>
    <section>
      <h2>Context</h2>
      <p>{project.context}</p>
    </section>
    <section>
      <h2>Process</h2>
      <p>{project.process}</p>
    </section>
    {project.images.map((image) => (
      <figure>
        <img
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading="lazy"
        />
      </figure>
    ))}
    <section>
      <h2>Outcome</h2>
      <p>{project.outcome}</p>
    </section>
    {project.technologies.length > 0 && (
      <section>
        <h2>Built with</h2>
        <ul>
          {project.technologies.map((technology) => (
            <li>{technology}</li>
          ))}
        </ul>
      </section>
    )}
    {project.links.length > 0 && (
      <section>
        <h2>Explore the project</h2>
        <ul>
          {project.links.map((link) => (
            <li>
              <a href={link.url}>{link.label}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</SiteLayout>
