---
import SiteLayout from '../layouts/SiteLayout.astro';
import Experience from '../components/experience/Experience';
import AsciiTacoLoader from '../components/experience/AsciiTacoLoader.astro';
import ThemePicker from '../components/ui/ThemePicker.astro';
import { modelUrl } from '../lib/glb-contract';
---

<SiteLayout title="Welcome" immersive>
  <AsciiTacoLoader slot="loader" />
  <script slot="head" is:inline define:vars={{ modelUrl }}>
    if (typeof WebGL2RenderingContext !== 'undefined') {
      const preload = document.createElement('link');
      preload.rel = 'preload';
      preload.as = 'fetch';
      preload.href = modelUrl;
      preload.crossOrigin = 'anonymous';
      document.head.append(preload);
    }
  </script>
  <section class="experience-section" aria-labelledby="welcome-title">
    <h1 id="welcome-title" class="sr-only">
      Taquería Aldo — interactive portfolio
    </h1>
    <p class="sr-only">
      Explore the stand or use the navigation to view the work, about and
      contact pages.
    </p>
    <Experience client:load />
    <div class="scene-controls">
      <div class="scene-controls-left">
        <span class="scene-index">01 / EXPLORE</span>
        <details class="salsa-menu">
          <summary>
            <span class="salsa-dot" aria-hidden="true" /> Choose salsa
          </summary>
          <div class="salsa-panel">
            <ThemePicker />
          </div>
        </details>
      </div>
      <a class="scene-work-link" href="/work">
        View work <span aria-hidden="true">↗</span>
      </a>
      <span class="sound-status" title="Guitar recording coming soon">
        <svg
          aria-hidden="true"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M11 5 6 9H3v6h3l5 4V5ZM16 9l5 6m0-6-5 6" />
        </svg>
        Sound off
      </span>
    </div>
  </section>
</SiteLayout>

<style>
  .experience-section {
    position: relative;
    min-height: 100svh;
  }
  .scene-controls {
    position: absolute;
    z-index: 5;
    inset: auto 0 0;
    padding: 0 clamp(1rem, 3vw, 2.5rem) max(1rem, env(safe-area-inset-bottom));
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 1rem;
    pointer-events: none;
    font-size: 0.72rem;
  }
  .scene-controls a,
  .scene-controls details {
    pointer-events: auto;
  }
  .scene-controls-left {
    justify-self: start;
  }
  .scene-index {
    display: block;
    font:
      0.62rem ui-monospace,
      monospace;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .salsa-menu {
    position: relative;
  }
  .salsa-menu summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
  }
  .salsa-menu summary::-webkit-details-marker {
    display: none;
  }
  .salsa-panel {
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.5rem);
    min-width: 280px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 1rem;
    box-shadow: 0 8px 30px #0005;
  }
  .scene-work-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    text-decoration: none;
  }
  .scene-work-link:hover {
    text-decoration: underline;
  }
  .sound-status {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    justify-self: end;
    min-height: 44px;
    color: var(--muted);
  }
  @media (max-width: 380px) {
    .scene-controls {
      gap: 0.5rem;
      font-size: 0.65rem;
    }
  }
</style>
