---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactPage from '../components/contact/ContactPage.astro';
import ThemePicker from '../components/ui/ThemePicker.astro';
import { contactContent } from '../content/contact';
import { siteContent } from '../content/site';
---

<SiteLayout title="Contact" description={contactContent.metadata}>
  <ContactPage />
  <footer slot="footer" class="contact-footer shell">
    <p>
      © {new Date().getFullYear()} {siteContent.name} · {contactContent.journey}
    </p>
    <ThemePicker />
    <a class="text-link" href="/">
      {contactContent.backLabel} <span aria-hidden="true">↗</span>
    </a>
  </footer>
</SiteLayout>

<style>
  .contact-footer {
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    padding-block: 1.75rem;
    color: var(--muted);
  }
  .contact-footer p {
    margin: 0;
    font-size: 0.75rem;
  }
  .contact-footer .text-link {
    font-size: 0.75rem;
  }
</style>
