---
import SiteLayout from '../layouts/SiteLayout.astro';
import { siteContent } from '../content/site';
---

<SiteLayout title="Contact">
  <div class="content-page shell">
    <header class="page-intro">
      <p class="eyebrow">Stay a little longer</p>
      <h1>Say hello.</h1>
    </header>
    <section class="empty-state">
      <h2>Find Aldo here.</h2>
      {siteContent.email ? (
        <p>
          <a href={`mailto:${siteContent.email}`}>{siteContent.email}</a>
        </p>
      ) : (
        <p>
          Contact details have not been supplied yet. An approved email address
          and social links will appear here.
        </p>
      )}
      {siteContent.socialLinks.length > 0 && (
        <ul>
          {siteContent.socialLinks.map((link) => (
            <li>
              <a href={link.url}>{link.label}</a>
            </li>
          ))}
        </ul>
      )}
      <a class="text-link" href="/">
        Return to the stand
      </a>
    </section>
  </div>
</SiteLayout>
