---
import SiteLayout from '../layouts/SiteLayout.astro';
import { siteContent } from '../content/site';
---

<SiteLayout title="About">
  <div class="content-page shell">
    <header class="page-intro">
      <p class="eyebrow">Behind the stand</p>
      <h1>About Aldo.</h1>
    </header>
    <section class="empty-state">
      <h2>A personal introduction, coming soon.</h2>
      <p>
        {siteContent.biography ??
          'This space is reserved for Aldo’s own biography. It will be filled with the creator’s words, rather than a made-up story.'}
      </p>
      <a class="text-link" href="/work">
        Explore the work
      </a>
    </section>
  </div>
</SiteLayout>
