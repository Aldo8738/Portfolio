---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found">
  <div class="content-page shell">
    <p class="eyebrow">404 · Wrong corner</p>
    <h1>This page isn’t on the menu.</h1>
    <p>The page may have moved, or this project has not been published.</p>
    <a class="button" href="/work">
      View work
    </a>{' '}
    <a class="text-link" href="/">
      Return to the stand
    </a>
  </div>
</SiteLayout>
