---
import type { Project } from '../../../content/portfolio';
import { orderedProjects, projectPath } from '../../../content/portfolio';
import { tradingAgentStory as content } from '../../../content/trading-research';
import ResearchDesk from './ResearchDesk.astro';
import '../work.css';
import './trading-agent.css';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const index = orderedProjects.findIndex((entry) => entry.slug === project.slug);
const previous = orderedProjects[index - 1];
const next = orderedProjects[index + 1];
---

<article class="work-case-study trading-page shell">
  <a class="text-link" href="/work#project-trading-agent">
    <span aria-hidden="true">←</span> Back to Selected work
  </a>
  <header class="trading-hero">
    <p class="eyebrow">
      {String(project.order).padStart(2, '0')} / {project.eyebrow.toUpperCase()}{' '}
      · {content.name}
    </p>
    <h1>
      {project.title}
      <span class="trading-title-dot">.</span>
    </h1>
    <div class="trading-hero-copy">
      <p class="trading-subheading">{project.hook}</p>
      <p>{content.introduction}</p>
    </div>
    <dl class="case-study-facts trading-facts">
      <div>
        <dt>Contribution</dt>
        <dd>{content.contribution}</dd>
      </div>
      <div>
        <dt>Focus &amp; technologies</dt>
        <dd>{project.technologies.join(' · ')}</dd>
      </div>
    </dl>
  </header>
  <ResearchDesk />
  <section
    class="trading-engineering"
    aria-labelledby="trading-engineering-title"
  >
    <p class="eyebrow">Behind the intelligence</p>
    <h2 id="trading-engineering-title">{content.engineeringHeading}</h2>
    <p class="trading-engineering-intro">{content.engineeringIntroduction}</p>
    <ol class="trading-workflow" role="list" aria-label="Research workflow">
      {content.workflow.map((step, index) => (
        <li>
          <span class="trading-workflow-index" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3>{step.title}</h3>
          <p>{step.detail}</p>
          {index < content.workflow.length - 1 && (
            <svg
              class="trading-workflow-arrow"
              viewBox="0 0 32 16"
              aria-hidden="true"
            >
              <path d="M1 8H30M23 1L30 8L23 15" />
            </svg>
          )}
        </li>
      ))}
    </ol>
    <div class="trading-contribution">
      <div>
        <p class="eyebrow">My contribution</p>
        <p class="trading-contribution-lead">
          {content.contributions.join(' · ')}
        </p>
        <p class="trading-contribution-note">{content.collaboration}</p>
      </div>
      <div>
        <p class="eyebrow">Delivery</p>
        <p class="trading-contribution-lead">{content.delivery}</p>
        <p class="trading-contribution-note">{content.deliveryContext}</p>
      </div>
    </div>
    {project.links && project.links.length > 0 && (
      <ul class="trading-project-links">
        {project.links.map((link) => (
          <li>
            <a class="text-link" href={link.url}>
              {link.label} ↗
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
  <nav class="project-sequence" aria-label="Project navigation">
    {previous && (
      <a href={projectPath(previous)} rel="prev">
        ← {previous.title}
      </a>
    )}
    {next && (
      <a href={projectPath(next)} rel="next">
        {next.title} →
      </a>
    )}
  </nav>
  <a class="text-link" href="/work">
    All selected work ↗
  </a>
</article>
