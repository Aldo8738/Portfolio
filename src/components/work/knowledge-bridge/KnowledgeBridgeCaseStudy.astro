---
import {
  knowledgeBridge as content,
  knowledgeBridgeBeats as beats,
  knowledgeBridgeMeasurements as measurements,
  knowledgeBridgeHumanAi as humanAi,
} from '../../../content/knowledge-bridge';
import { orderedProjects, projectPath } from '../../../content/portfolio';
import KnowledgeGraph from './KnowledgeGraph.astro';
import '../work.css';
import './knowledge-bridge.css';
const next = orderedProjects.find((project) => project.order === 2);
const [titleFirstLine, titleSecondLine] = content.title.slice(0, -1).split(' ');
---

<article
  class="work-case-study kb-page shell"
  data-case-study
  data-knowledge-bridge
>
  <a class="text-link" href="/work#project-knowledge-bridge">
    <span aria-hidden="true">←</span> Back to Selected work
  </a>
  <header class="kb-hero" data-kb-section>
    <div class="kb-hero-heading" data-hero-copy>
      <p class="eyebrow">{content.eyebrow}</p>
      <h1>
        {titleFirstLine}
        <br />
        {titleSecondLine}
        <span class="kb-title-dot">.</span>
      </h1>
    </div>
    <div class="kb-hero-description">
      <p class="kb-subheading">{content.subheading}</p>
      <p class="kb-introduction">{content.introduction}</p>
    </div>
    <div class="kb-hero-metric">
      <strong>
        <span class="sr-only">{measurements[0].reduction}%</span>
        <span data-hero-value aria-hidden="true">
          {measurements[0].reduction}
        </span>
        <span class="kb-hero-unit" aria-hidden="true">
          %
        </span>
      </strong>
      <div>
        <p>Shorter graph rendering time</p>
        <span class="kb-caption">Reddit, 100 items</span>
      </div>
    </div>
    <dl class="case-study-facts kb-facts">
      <div>
        <dt>Contribution</dt>
        <dd>{content.engineering.contribution}</dd>
      </div>
      <div>
        <dt>Focus &amp; technologies</dt>
        <dd>{content.engineering.technologies.join(' · ')}</dd>
      </div>
    </dl>
  </header>
  <section
    class="kb-story"
    aria-labelledby="kb-story-title"
    data-kb-section
    data-kb-story
  >
    <div class="kb-scene-layer">
      <div class="kb-network" data-network-host data-layout="mobile">
        <KnowledgeGraph />
      </div>
    </div>
    <div class="kb-story-stage" data-story-stage>
      <div class="kb-story-topline">
        <p class="eyebrow" id="kb-story-title">
          The living graph / Knowledge Bridge
        </p>
        <span class="kb-caption" data-scroll-hint hidden>
          Scroll to explore ↓
        </span>
      </div>
      <div
        class="kb-story-progress"
        data-story-progress-track
        hidden
        aria-hidden="true"
      >
        <span data-story-progress></span>
      </div>
      <ol class="kb-beats kb-chapter-one-copy" aria-label="Chapter 1">
        <li data-story-beat="0">
          <span class="kb-beat-number" aria-hidden="true">
            01 / OVERLOAD
          </span>
          <h2>{beats[0].title}</h2>
          <p>{beats[0].description}</p>
        </li>
      </ol>
      <div class="kb-chapter-one-dock" data-chapter-one-dock aria-hidden="true">
        <div class="kb-overload-dock" data-overload-dock></div>
      </div>
      <ol class="kb-beats kb-solution-copy" aria-label="Chapter 2">
        <li data-story-beat="1">
          <span class="kb-beat-number" aria-hidden="true">
            02 / FOCUS
          </span>
          <h2>{beats[1].title}</h2>
          <p>{beats[1].description}</p>
        </li>
      </ol>
      <div class="kb-focus-dock" data-focus-dock aria-hidden="true"></div>
      <ol class="kb-beats kb-human-copy" aria-label="Chapter 3">
        <li data-story-beat="2">
          <span class="kb-beat-number" aria-hidden="true">
            {humanAi.eyebrow}
          </span>
          <h2>{beats[2].title}</h2>
          <p>{beats[2].description}</p>
        </li>
      </ol>
      <ol class="kb-human-summary" aria-label="Illustrated human correction">
        {humanAi.steps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
      <div class="kb-human-dock" data-human-dock aria-hidden="true"></div>
    </div>
  </section>
  <section
    class="kb-results"
    aria-labelledby="kb-results-title"
    data-kb-section
  >
    <div class="kb-section-heading">
      <p class="eyebrow">{content.engineering.eyebrow}</p>
      <h2 id="kb-results-title">{content.engineering.heading}</h2>
    </div>
    <dl class="kb-results-metrics">
      <div class="kb-result-primary">
        <dt>{measurements[0].reduction}% shorter graph rendering time</dt>
        <dd>
          <span>{measurements[0].before.toFixed(2)}s</span>
          <span aria-hidden="true"> → </span>
          <strong>{measurements[0].after.toFixed(2)}s</strong>
          <small>Reddit · 100 items</small>
        </dd>
      </div>
      <div class="kb-result-secondary">
        <dt>shorter page load time</dt>
        <dd>
          <strong>{measurements[1].reduction}%</strong>
          <small>
            {measurements[1].before.toFixed(2)}s →{' '}
            {measurements[1].after.toFixed(2)}s · Reddit, 600 items
          </small>
        </dd>
      </div>
    </dl>
    <p class="kb-caption">{content.engineering.footnote}</p>
    <nav class="project-sequence kb-sequence" aria-label="Project navigation">
      <a class="text-link" href="/work">
        All selected work <span aria-hidden="true">↗</span>
      </a>
      {next && (
        <a href={projectPath(next)} rel="next">
          Next: {next.title} <span aria-hidden="true">→</span>
        </a>
      )}
    </nav>
  </section>
</article>

<script>
  import { mountKnowledgeBridge } from './knowledge-bridge';
  const root = document.querySelector<HTMLElement>('[data-knowledge-bridge]');
  if (root) {
    let dispose = mountKnowledgeBridge(root);
    window.addEventListener('pagehide', () => dispose());
    document.addEventListener('astro:before-swap', () => dispose(), {
      once: true,
    });
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) dispose = mountKnowledgeBridge(root);
    });
  }
</script>
