---
import {
  overloadNodes,
  overloadBranches,
  overloadConnections,
  overloadConnectionPath,
  knowledgeNodes,
  graphLinks,
  graphPoint,
  curvedLink,
  correctionPath,
  peripheralPoints,
  peripheralPath,
  knowledgeCorrection,
  graphNode,
} from '../../../content/knowledge-graph';

const revealGroups: Record<string, number> = {
  europe: 0,
  germany: 0,
  cities: 1,
  berlin: 1,
  landmarks: 2,
  eiffel: 2,
  gate: 2,
};
---

<svg
  class="project-diagram kb-graph"
  viewBox="0 0 400 360"
  role="img"
  aria-labelledby="kb-graph-title kb-graph-description"
>
  <title id="kb-graph-title">The living knowledge graph</title>
  <desc id="kb-graph-description">
    A dense geographical network includes North America, Mexico and Querétaro.
    It focuses into the same European cluster. Illustrative portfolio
    reconstruction, not the research dataset or original product UI. Europe
    connects France and Germany with their cities and landmarks. A proposed
    Paris to Germany relationship is corrected to Paris to France. The corrected
    relationship reconnects and remains visible.
  </desc>
  <defs>
    <marker
      id="kb-arrow"
      viewBox="0 0 8 8"
      refX="7"
      refY="4"
      markerWidth="6"
      markerHeight="6"
      orient="auto"
    >
      <path d="M1 1L7 4L1 7" fill="none" stroke="currentColor" />
    </marker>
  </defs>
  <g data-graph-scene>
    <g class="kb-overload" data-overload-only opacity="0">
      {overloadConnections.map((edge, index) => (
        <path
          data-overload-connection={index}
          class={`kb-overload--${edge.role}`}
          data-mobile-omit={!edge.mobileVisible ? '' : undefined}
          d={overloadConnectionPath(index, 'mobile')}
        />
      ))}
      {overloadNodes.map((node) => (
        <g
          data-overload-node={node.id}
          transform={`translate(${node.mobile.x} ${node.mobile.y})`}
        >
          <circle
            r={node.id === 'queretaro' ? 4 : node.label ? 6 : 3.5}
            class={
              node.id === 'queretaro'
                ? 'kb-personal-dot'
                : node.label
                  ? 'kb-overload--primary'
                  : 'kb-overload--secondary'
            }
          />
          {node.label && (
            <text
              data-overload-label={
                node.id === 'queretaro' ? 'tertiary' : 'secondary'
              }
              y={['north-america', 'mexico'].includes(node.id) ? -28 : -13}
              text-anchor="middle"
            >
              {node.label}
            </text>
          )}
        </g>
      ))}
      {overloadBranches.map((node, index) => (
        <circle
          data-mobile-omit={!node.mobileVisible ? '' : undefined}
          class={`kb-overload--${node.role}`}
          data-overload-point={index}
          cx={node.mobile.x}
          cy={node.mobile.y}
          r={node.role === 'secondary' ? 3.5 : 2.1}
        />
      ))}
    </g>
    <g data-expansion>
      {['europe', 'france', 'germany', 'paris', 'berlin', 'landmarks'].map(
        (anchor) => (
          <g
            class="kb-periphery"
            data-extra-detail
            data-network-detail
            data-distant-detail={
              !['france', 'paris'].includes(anchor) ? '' : undefined
            }
            data-near-detail={
              ['france', 'paris'].includes(anchor) ? '' : undefined
            }
          >
            {peripheralPoints.map(
              (point, index) =>
                point.anchor === anchor && (
                  <g data-mobile-omit={!point.mobileVisible ? '' : undefined}>
                    <path
                      d={peripheralPath(index, 'mobile')}
                      data-peripheral-path={index}
                    />
                    <circle
                      cx={point.mobile.x}
                      cy={point.mobile.y}
                      r={point.radius}
                      data-peripheral-point={index}
                    />
                  </g>
                ),
            )}
          </g>
        ),
      )}
    </g>
    <g data-expansion>
      <g class="kb-edges" data-graph-layer="structure" data-core-relationships>
        {graphLinks.map(([from, to], index) => (
          <path
            d={curvedLink(graphPoint(from, 'mobile'), graphPoint(to, 'mobile'))}
            data-core-edge
            data-network-edge={index}
            data-reveal-group={Math.max(
              revealGroups[from] ?? -1,
              revealGroups[to] ?? -1,
            )}
            data-mobile-omit={
              graphNode(from).mobileOmit || graphNode(to).mobileOmit
                ? ''
                : undefined
            }
            data-distant-detail={
              !['paris', 'france'].includes(from) ? '' : undefined
            }
          />
        ))}
      </g>
    </g>
    <g class="kb-edges" data-core-relationships>
      <path
        d={correctionPath('mobile', false)}
        data-incorrect-edge
        opacity="0"
      />
      <path
        d={correctionPath('mobile', true)}
        data-corrected-edge
        pathLength="1"
        class="kb-accent-line"
      />
    </g>
    <g data-graph-layer="viewport" class="kb-viewport" opacity="0">
      <path
        d="M45 140V130H65M155 130H175V140M175 255V265H155M65 265H45V255"
        pathLength="1"
        data-viewport-frame
      />
      <text x="50" y="118" class="kb-art-note" data-viewport-label>
        VISIBLE REGION
      </text>
    </g>
    {knowledgeNodes.map((node) => (
      <g
        data-expansion={!['paris', 'france'].includes(node.id) ? '' : undefined}
        data-core-node
        data-mobile-omit={node.mobileOmit ? '' : undefined}
      >
        <g
          class={`kb-node kb-node--${node.role}`}
          transform={`translate(${node.mobile.x} ${node.mobile.y})`}
          data-node-id={node.id}
          data-reveal-group={revealGroups[node.id]}
          data-near-detail={node.focused ? '' : undefined}
          data-distant-detail={!node.focused ? '' : undefined}
          data-flow-soften={
            !Object.values(knowledgeCorrection).some((id) => id === node.id)
              ? ''
              : undefined
          }
        >
          <circle
            class="kb-item-mark"
            r={node.role === 'idea' ? 10 : node.role === 'cluster' ? 7 : 4.5}
          />
          {['paris', 'france'].includes(node.id) && (
            <rect
              data-label-frame
              class="kb-label-frame"
              x="-52"
              y={node.id === 'paris' ? 10 : -43}
              width="104"
              height="36"
              rx="18"
              opacity="0"
            />
          )}
          <text
            class="kb-anchor-label"
            data-overload-label={node.overloadLabelTier}
            x="0"
            y={
              ['paris', 'berlin', 'eiffel', 'gate'].includes(node.id) ? 25 : -16
            }
            text-anchor="middle"
          >
            {node.label}
          </text>
          {node.id === knowledgeCorrection.entity && (
            <circle
              class="kb-selection-ring"
              r="14"
              opacity="0"
              data-selection-ring
            />
          )}
        </g>
      </g>
    ))}
    <g data-graph-layer="priority" opacity="0">
      <path
        data-priority-path
        class="kb-channel"
        d="M210 85C180 70 130 75 95 110"
        marker-end="url(#kb-arrow)"
      />
      <text
        class="kb-art-note"
        x="230"
        y="65"
        text-anchor="end"
        data-priority-label
      >
        PRIORITIZED UPDATE
      </text>
      <circle data-priority-packet r="3" class="kb-packet" opacity="0" />
    </g>
    <text
      class="kb-art-note"
      x="200"
      y="70"
      text-anchor="middle"
      data-proposal-label
      opacity="0"
    >
      PROPOSED / INCORRECT
    </text>
    <text
      class="kb-art-note kb-human-edit-label"
      x="200"
      y="70"
      text-anchor="middle"
      data-human-edit-label
      opacity="0"
    >
      HUMAN CORRECTION
    </text>
    <text
      class="kb-art-note kb-human-edit-label"
      x="200"
      y="70"
      text-anchor="middle"
      data-ai-learns-label
      opacity="0"
    >
      AI LEARNS
    </text>
    <g data-graph-layer="backend" opacity="0">
      <path
        class="kb-channel"
        data-edit-path
        pathLength="1"
        d="M110 200C140 200 140 277 165 277"
        marker-end="url(#kb-arrow)"
      />
      <path
        class="kb-channel"
        data-return-path
        pathLength="1"
        d="M165 277C140 277 140 200 110 200"
        marker-end="url(#kb-arrow)"
      />
      <text
        class="kb-art-note"
        x="225"
        y="205"
        text-anchor="middle"
        data-edit-label
      >
        <tspan x="225">USER EDIT</tspan>
        <tspan x="225" dy="20">
          / API
        </tspan>
      </text>
      <text
        class="kb-art-note"
        x="225"
        y="205"
        text-anchor="middle"
        data-return-label
      >
        <tspan x="225">WEBSOCKET</tspan>
        <tspan x="225" dy="20">
          UPDATE
        </tspan>
      </text>
      <g
        transform="translate(165 250)"
        class="kb-backend-node"
        data-backend-node
      >
        <rect width="150" height="54" rx="27" data-backend-shape />
        <text
          x="75"
          y="33"
          text-anchor="middle"
          class="kb-art-note"
          data-backend-label
        >
          BACKEND
        </text>
        <text
          x="75"
          y="33"
          text-anchor="middle"
          class="kb-art-note"
          data-processing-label
          opacity="0"
        >
          PROCESSING
        </text>
      </g>
      <circle data-feedback-packet r="3.5" class="kb-packet" opacity="0" />
      <circle data-delivery-packet r="3.5" class="kb-packet" opacity="0" />
    </g>
    <circle
      class="kb-personal-dot"
      data-berlin-anchor
      data-overload-only
      cx="300"
      cy="200"
      r="3"
      opacity="0"
    />
  </g>
</svg>
