---
import { contactContent, getContactMethods } from '../../content/contact';
import ContactSymbols from './ContactSymbols.astro';
const methods = getContactMethods(contactContent.methods);
---

<article
  class="contact-page shell"
  data-contact-page
  aria-labelledby="contact-title"
>
  <div class="contact-hero">
    <header>
      <p class="eyebrow" data-contact-heading>
        {contactContent.eyebrow}
      </p>
      <h1 id="contact-title" data-contact-heading>
        {contactContent.headline.replace(/\?$/, '')}
        <span class="contact-accent">?</span>
      </h1>
      <p class="contact-description" data-contact-description>
        {contactContent.description}
      </p>
    </header>
    <ContactSymbols methods={methods} />
  </div>
  <p class="contact-closing" data-contact-closing>
    {contactContent.closing}
  </p>
</article>

<script>
  import { mountContactPage } from './contact-page';
  const root = document.querySelector<HTMLElement>('[data-contact-page]');
  if (root) {
    let dispose = mountContactPage(root);
    window.addEventListener('pagehide', () => dispose());
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) dispose = mountContactPage(root);
    });
  }
</script>

<style>
  .contact-page {
    padding-block: clamp(3.5rem, 6vw, 6rem) 3rem;
  }
  .contact-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  h1 {
    max-width: 10ch;
    text-wrap: balance;
    font-size: clamp(3.5rem, 7.5vw, 8rem);
    line-height: 0.98;
    margin-block: 2rem 0;
    overflow-wrap: anywhere;
  }
  .contact-accent {
    color: var(--accent);
  }
  .contact-description {
    color: var(--muted);
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    max-width: 36ch;
    margin: 2rem 0 0;
  }
  .contact-closing {
    color: var(--muted);
    font-size: 0.8rem;
    margin: 2rem 0 0;
  }
  @media (max-width: 1000px) {
    .contact-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
    h1 {
      font-size: clamp(3.25rem, 11vw, 5.5rem);
      max-width: 12ch;
    }
  }
</style>
