---
import linkedinBlack from '../../../public/images/contact/linkedin-in-black.png?inline';
import linkedinWhite from '../../../public/images/contact/linkedin-in-white.png?inline';
import instagramBlack from '../../../public/images/contact/instagram-glyph-black.svg?inline';
import instagramWhite from '../../../public/images/contact/instagram-glyph-white.svg?inline';
import mailBlack from '../../../public/images/contact/mail-outline.svg?inline';
import mailWhite from '../../../public/images/contact/mail-outline-white.svg?inline';
import type { ContactMethod } from '../../content/contact';
interface Props {
  methods: readonly (ContactMethod & { href: string })[];
}
const { methods } = Astro.props;
const iconSources: Readonly<Record<string, string>> = {
  '/images/contact/linkedin-in-black.png': linkedinBlack,
  '/images/contact/linkedin-in-white.png': linkedinWhite,
  '/images/contact/instagram-glyph-black.svg': instagramBlack,
  '/images/contact/instagram-glyph-white.svg': instagramWhite,
  '/images/contact/mail-outline.svg': mailBlack,
  '/images/contact/mail-outline-white.svg': mailWhite,
};
// Vite embeds the assets before prerendering; no source filesystem is needed at render time.
function iconSource(src: string) {
  const source = iconSources[src];
  if (!source) throw new Error(`Invalid Contact icon path: ${src}`);
  return source;
}
---

<ul class="contact-symbols" aria-label="Ways to connect">
  {methods.map((method) => (
    <li>
      <a
        class="contact-symbol"
        data-contact-symbol={method.id}
        data-contact-method={method.id}
        href={method.href}
        target={method.external ? '_blank' : undefined}
        rel={method.external ? 'noopener noreferrer' : undefined}
      >
        <span class="contact-symbol-art" aria-hidden="true">
          <img
            class="contact-mark contact-mark--light"
            src={iconSource(method.icon.src)}
            width={method.icon.width}
            height={method.icon.height}
            alt=""
          />
          <img
            class="contact-mark contact-mark--dark"
            src={iconSource(method.icon.darkSrc)}
            width={method.icon.width}
            height={method.icon.height}
            alt=""
          />
        </span>
        <span class="contact-label">{method.label}</span>
        {method.external && <span class="sr-only"> (opens in a new tab)</span>}
      </a>
    </li>
  ))}
</ul>

<style>
  .contact-symbols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    width: 100%;
    max-width: 760px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .contact-symbol {
    display: block;
    position: relative;
    min-height: 44px;
    text-align: center;
    text-decoration: none;
    padding-bottom: 1.25rem;
    cursor: pointer;
  }
  .contact-symbol-art {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    width: 100%;
    max-width: 240px;
    margin-inline: auto;
  }
  .contact-mark {
    display: block;
    width: 48%;
    max-width: 104px;
    height: auto;
  }
  [data-contact-method='email'] .contact-mark {
    width: 56%;
    max-width: 120px;
  }
  .contact-mark--dark {
    display: none;
  }
  :global(html[data-theme='synthwave']) .contact-mark--light {
    display: none;
  }
  :global(html[data-theme='synthwave']) .contact-mark--dark {
    display: block;
  }
  .contact-label {
    display: block;
    font-size: clamp(0.8rem, 1.4vw, 1.2rem);
    font-weight: 600;
    line-height: 1.5;
  }
  .contact-symbol::after {
    content: '';
    position: absolute;
    left: 25%;
    right: 25%;
    bottom: 0;
    height: 1px;
    background: var(--accent);
    opacity: 0;
  }
  .contact-symbol:hover::after,
  .contact-symbol:focus-visible::after {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .contact-symbol::after {
      transition: opacity 220ms ease;
    }
  }
  @media (max-width: 700px) {
    .contact-symbols {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 5rem), 1fr));
    }
  }
</style>
