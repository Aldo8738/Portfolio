---
import rendererSource from '../../lib/ascii-taco.js?raw';

const inlineScript = `(() => {
${rendererSource.replace('export function createAsciiTaco', 'function createAsciiTaco')}
  const loader = document.getElementById('ascii-taco-loader');
  const canvas = document.getElementById('ascii-taco-canvas');
  if (!(loader instanceof HTMLDialogElement) || !(canvas instanceof HTMLCanvasElement)) return;
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  const minimumVisibleMs = 2000;
  let taco;
  let finished = false;
  let shownAt = 0;
  let minimumTimer;
  function visibility() {
    if (!finished) document.hidden ? taco?.pause() : taco?.resume();
  }
  function finish() {
    if (finished) return;
    finished = true;
    clearTimeout(timeout);
    clearTimeout(minimumTimer);
    taco?.destroy();
    document.removeEventListener('visibilitychange', visibility);
    motion.removeEventListener('change', restart);
    window.removeEventListener('taqueria:scene-settled', settle);
    loader.removeEventListener('cancel', finish);
    loader.close();
    canvas.width = canvas.height = 1;
    loader.remove();
    window.dispatchEvent(new Event('taqueria:loader-dismissed'));
  }
  function settle(event) {
    if (event.detail === 'ready') {
      const bar = loader.querySelector('[role="progressbar"]');
      bar?.setAttribute('aria-valuenow', '100');
      bar?.setAttribute('data-complete', 'true');
    }
    const remaining = minimumVisibleMs - (performance.now() - shownAt);
    if (remaining <= 0) finish();
    else {
      clearTimeout(minimumTimer);
      minimumTimer = setTimeout(finish, remaining);
    }
  }
  function restart() {
    if (finished) return;
    taco?.destroy();
    try {
      taco = createAsciiTaco(canvas, { reducedMotion: motion.matches });
      visibility();
    } catch (error) {
      console.warn('ASCII taco unavailable; using the loading status.', error);
      finish();
    }
  }
  const timeout = setTimeout(finish, 20000);
  document.addEventListener('visibilitychange', visibility);
  motion.addEventListener('change', restart);
  window.addEventListener('taqueria:scene-settled', settle);
  loader.addEventListener('cancel', finish);
  loader.hidden = false;
  loader.showModal();
  performance.mark('taqueria:loader-start');
  restart();
  shownAt = performance.now();
  performance.mark('taqueria:loader-first-frame');
  performance.measure('taqueria:loader-setup', 'taqueria:loader-start', 'taqueria:loader-first-frame');
})();`;
---

<dialog id="ascii-taco-loader" aria-labelledby="taco-loading-status" hidden>
  <p
    id="taco-loading-status"
    class="sr-only"
    tabindex="-1"
    autofocus
    role="status"
  >
    Calentando el comal… Loading Taquería Aldo.
  </p>
  <a class="skip-link" href="/work">
    Skip loading and view work
  </a>
  <div class="loader-content">
    <canvas id="ascii-taco-canvas" aria-hidden="true"></canvas>
    <div
      class="loading-bar"
      role="progressbar"
      aria-label="Loading Taquería Aldo"
    >
      <span></span>
    </div>
  </div>
  <script is:inline set:html={inlineScript} />
</dialog>

<style>
  #ascii-taco-loader {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100svh;
    max-width: none;
    max-height: none;
    padding: 0;
    margin: 0;
    border: 0;
    overflow: hidden;
    background: #000;
    color: #fff;
  }
  #ascii-taco-loader::backdrop {
    background: #000;
  }
  .loader-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(360px, 80vw);
  }
  #ascii-taco-canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
  }
  .loading-bar {
    width: min(220px, 80%);
    height: 3px;
    margin: 1rem auto 0;
    overflow: hidden;
    border-radius: 2px;
    background: #242424;
  }
  .loading-bar span {
    display: block;
    width: 40%;
    height: 100%;
    background: #ffd342;
    animation: loading-sweep 1s ease-in-out infinite;
  }
  .loading-bar[data-complete='true'] span {
    width: 100%;
    animation: none;
    transform: none;
  }
  @keyframes loading-sweep {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(250%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .loading-bar span {
      animation: none;
      transform: translateX(75%);
    }
  }
</style>
