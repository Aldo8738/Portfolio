---
import rendererSource from '../../lib/ascii-taco.js?raw';

const inlineScript = `(() => {
${rendererSource.replace('export function createAsciiTaco', 'function createAsciiTaco')}
  const loader = document.getElementById('ascii-taco-loader');
  const canvas = document.getElementById('ascii-taco-canvas');
  if (!(loader instanceof HTMLDialogElement) || !(canvas instanceof HTMLCanvasElement)) return;
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  const minimumVisibleMs = 400;
  let taco;
  let finished = false;
  let shownAt = 0;
  let minimumTimer;
  let progress = 0;
  const bar = loader.querySelector('[role="progressbar"]');
  const caption = loader.querySelector('.loading-caption');
  function updateProgress(value, message) {
    progress = Math.max(progress, value);
    bar?.setAttribute('aria-valuenow', String(progress));
    bar?.setAttribute('aria-valuetext', message);
    bar?.style.setProperty('--progress', progress + '%');
    if (caption) caption.textContent = message;
  }
  function download(event) {
    const detail = event.detail;
    if (!detail || !Number.isFinite(detail.loaded) || !Number.isFinite(detail.total) ||
        detail.total <= 0 || detail.loaded < 0) return;
    const percent = Math.min(100, Math.floor(detail.loaded / detail.total * 100));
    // Reserve completion for the first usable frame, including textures and GPU setup.
    updateProgress(Math.min(99, percent), percent === 100
      ? 'Download complete. Preparing the scene…'
      : 'Downloading the stand… ' + percent + '%');
  }
  function visibility() {
    if (!finished) document.hidden ? taco?.pause() : taco?.resume();
  }
  function finish() {
    if (finished) return;
    finished = true;
    clearTimeout(timeout);
    clearTimeout(minimumTimer);
    taco?.destroy();
    document.removeEventListener('visibilitychange', visibility);
    motion.removeEventListener('change', restart);
    window.removeEventListener('taqueria:scene-settled', settle);
    window.removeEventListener('taqueria:scene-progress', download);
    loader.removeEventListener('cancel', finish);
    loader.close();
    canvas.width = canvas.height = 1;
    loader.remove();
    window.dispatchEvent(new Event('taqueria:loader-dismissed'));
  }
  function settle(event) {
    if (event.detail === 'ready') {
      updateProgress(100, 'Taquería Aldo is ready.');
    }
    const remaining = minimumVisibleMs - (performance.now() - shownAt);
    if (remaining <= 0) finish();
    else {
      clearTimeout(minimumTimer);
      minimumTimer = setTimeout(finish, remaining);
    }
  }
  function restart() {
    if (finished) return;
    taco?.destroy();
    try {
      taco = createAsciiTaco(canvas, { reducedMotion: motion.matches });
      visibility();
    } catch (error) {
      console.warn('ASCII taco unavailable; using the loading status.', error);
      finish();
    }
  }
  const timeout = setTimeout(finish, 20000);
  document.addEventListener('visibilitychange', visibility);
  motion.addEventListener('change', restart);
  window.addEventListener('taqueria:scene-settled', settle);
  window.addEventListener('taqueria:scene-progress', download);
  loader.addEventListener('cancel', finish);
  loader.hidden = false;
  loader.showModal();
  performance.mark('taqueria:loader-start');
  restart();
  // Redraw even in reduced motion when the optional web font becomes available.
  document.fonts.ready.then(() => document.fonts.load('700 12px "Fira Code"'))
    .then(restart)
    .catch(() => { /* Keep the immediately rendered monospace fallback. */ });
  shownAt = performance.now();
  performance.mark('taqueria:loader-first-frame');
  performance.measure('taqueria:loader-setup', 'taqueria:loader-start', 'taqueria:loader-first-frame');
})();`;
---

<dialog id="ascii-taco-loader" aria-labelledby="taco-loading-status" hidden>
  <p
    id="taco-loading-status"
    class="sr-only"
    tabindex="-1"
    autofocus
    role="status"
  >
    Calentando el comal… Loading Taquería Aldo.
  </p>
  <a class="skip-link" href="/work">
    Skip loading and view work
  </a>
  <div class="loader-content">
    <canvas id="ascii-taco-canvas" aria-hidden="true"></canvas>
    <div
      class="loading-bar"
      role="progressbar"
      aria-label="Loading Taquería Aldo"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      aria-valuetext="Preparing the download"
    >
      <span class="ascii-track" aria-hidden="true">
        [░░░░░░░░░░░░░░░░░░░░]
      </span>
      <span class="ascii-fill" aria-hidden="true">
        [████████████████████]
      </span>
    </div>
    <p class="loading-caption" aria-hidden="true">
      Loading Taquería Aldo…
    </p>
  </div>
  <script is:inline set:html={inlineScript} />
</dialog>

<style>
  #ascii-taco-loader {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100svh;
    max-width: none;
    max-height: none;
    padding: 0;
    margin: 0;
    border: 0;
    overflow: hidden;
    background: #000;
    color: #e4e4e7;
    font-family: 'Fira Code', monospace;
  }
  #ascii-taco-loader::backdrop {
    background: #000;
  }
  .loader-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(360px, 80vw);
  }
  #ascii-taco-canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
  }
  .loading-bar {
    position: relative;
    width: max-content;
    margin: 1rem auto 0;
    font:
      14px / 1.5 'Fira Code',
      monospace;
    white-space: pre;
  }
  .ascii-track {
    display: block;
    opacity: 0.35;
  }
  .ascii-fill {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--progress, 0%)) 0 0);
  }
  .loading-caption {
    margin: 16px 0 0;
    text-align: center;
    font:
      14px / 1.5 'Fira Code',
      monospace;
    opacity: 0.8;
  }
</style>
