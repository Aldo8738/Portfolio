---
import {
  formatCareerMonth,
  getSkill,
  type CareerEntry,
} from '../../content/cv';
import { getProject, projectPath } from '../../content/portfolio';
interface Props {
  entry: CareerEntry;
}
const { entry } = Astro.props;
const related = entry.relatedProjectId
  ? getProject(entry.relatedProjectId)
  : undefined;
---

<li
  class="career-entry"
  data-career-entry={entry.id}
  data-skill-ids={entry.skillIds.join(' ')}
  data-current={Boolean(entry.current)}
  data-kind={entry.kind}
>
  <div class="career-date">
    <span>
      <time datetime={entry.start}>{formatCareerMonth(entry.start)}</time>
      <span aria-hidden="true"> —</span>
    </span>
    {entry.end === null ? (
      <span>Present</span>
    ) : (
      <time datetime={entry.end}>{formatCareerMonth(entry.end)}</time>
    )}
  </div>
  <span class="career-marker" aria-hidden="true" />
  <div class="career-copy" data-cv-reveal>
    <div class="career-heading">
      <h3 id={`career-${entry.id}`}>
        <a class="career-title-link" href={entry.websiteUrl}>
          {entry.displayName}
        </a>
      </h3>
      {entry.current && <span class="current-label">Current role</span>}
    </div>
    <p class="career-role">{entry.role}</p>
    <p class="career-location">{entry.location}</p>
    <p class="career-summary">{entry.summary}</p>
    {entry.highlight && <p class="career-highlight">{entry.highlight}</p>}
    {entry.skillIds.length > 0 && (
      <ul class="career-stack" aria-label={`${entry.displayName} tools`}>
        {entry.skillIds.map((id) => (
          <li>{getSkill(id).label}</li>
        ))}
      </ul>
    )}
    {entry.details.length > 0 && (
      <details class="career-details">
        <summary aria-label={`Role details for ${entry.displayName}`}>
          Role details <span aria-hidden="true">+</span>
        </summary>
        <ul>
          {entry.details.map((detail) => (
            <li>{detail}</li>
          ))}
        </ul>
      </details>
    )}
    {related && (
      <a class="text-link" href={projectPath(related)}>
        Explore {related.title} <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>
</li>
