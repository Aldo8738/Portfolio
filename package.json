{
  "name": "taqueria-aldo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "validate:asset": "node scripts/validate-asset.mjs",
    "capture:scene": "node scripts/capture-scene.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "astro": "7.4.1",
    "gsap": "3.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
